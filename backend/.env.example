# Copy to .env (or export these in your shell). All values are optional.
# Never commit a real .env file. This project needs no API keys.
PORT=3000
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Embedding model used for RAG (run: ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
CORS_ORIGIN=http://localhost:4200
# KNOWLEDGE_DIR=./knowledge
# VECTOR_STORE=./knowledge/.vector-store.json
# Number of chunks given to the model, and the minimum cosine similarity (0-1)
RAG_TOP_K=4
RAG_MIN_SCORE=0.3
